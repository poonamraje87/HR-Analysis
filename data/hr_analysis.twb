      <table>
        <view>
          <datasources>
            <datasource caption='HR data (HR Data)' name='federated.0qwcldl0l015tb12y3afi1o80f39' />
          </datasources>
          <datasource-dependencies datasource='federated.0qwcldl0l015tb12y3afi1o80f39'>
            <column datatype='string' name='[Attrition]' role='dimension' type='nominal' />
            <column caption='Attrition Rate' datatype='real' default-format='p0.00%' name='[Calculation_0070150597394432]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM( &#13;&#10;IF [Attrition] = &quot;Yes&quot; THEN 1 &#13;&#10;ELSE 0 &#13;&#10;END&#13;&#10;) &#13;&#10;/&#13;&#10;COUNT([Employee Number])' />
            </column>
            <column caption='Work-Life Balance Category' datatype='string' name='[Calculation_0070150615400451]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Work Life Balance]&#13;&#10;    WHEN 1 THEN &quot;Poor&quot;&#13;&#10;    WHEN 2 THEN &quot;Better&quot;&#13;&#10;    WHEN 3 THEN &quot;Good&quot;&#13;&#10;    WHEN 4 THEN &quot;Best&quot;&#13;&#10;END' />
            </column>
            <column datatype='integer' name='[Employee Number]' role='dimension' type='ordinal' />
            <column datatype='integer' name='[Work Life Balance]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_0070150615400451]' derivation='None' name='[none:Calculation_0070150615400451:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_0070150597394432]' derivation='User' name='[usr:Calculation_0070150597394432:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <shelf-sorts>
            <shelf-sort-v2 dimension-to-sort='[federated.0qwcldl0l015tb12y3afi1o80f39].[none:Calculation_0070150615400451:nk]' direction='DESC' is-on-innermost-dimension='true' measure-to-sort-by='[federated.0qwcldl0l015tb12y3afi1o80f39].[usr:Calculation_0070150597394432:qk]' shelf='columns' />
