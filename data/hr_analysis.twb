    <worksheet name='Attrition Rate By Work-Life Balance'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#1e3a8a' fontname='Tableau Bold' fontsize='11'>Attrition Rate By Work-Life Balance</run>
          </formatted-text>
        </title>
